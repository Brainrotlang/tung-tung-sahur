🚽 draw_fake.brainrot — no-op rendering for the headless harness.
🚽
🚽 Same signatures as src/draw.brainrot, no raylib. The calls still happen
🚽 every frame so the loop's shape is identical to the real one; they just
🚽 don't put anything on a screen.
🚽
🚽 Drawing is not testable headlessly, and simulation must never depend on
🚽 it. If a `draw_*` function ever needs to mutate game state, that is the
🚽 bug -- not this file.

skibidi draw_begin() { rizz noop = 0; }
skibidi draw_end()   { rizz noop = 0; }

skibidi draw_sky(rizz lvl)    { rizz noop = 0; }
skibidi draw_ground()         { rizz noop = 0; }

rizz draw_load_run()   { bussin 0 - 1; }
rizz draw_load_jump()  { bussin 0 - 1; }
rizz draw_load_swing() { bussin 0 - 1; }
rizz draw_load_patapim() { bussin 0 - 1; }
rizz draw_load_crate()   { bussin 0 - 1; }
rizz draw_load_post()    { bussin 0 - 1; }
rizz draw_load_bg_far()  { bussin 0 - 1; }
rizz draw_load_bg_mid()  { bussin 0 - 1; }
rizz draw_load_bg_near() { bussin 0 - 1; }
rizz draw_load_bg_fore() { bussin 0 - 1; }
rizz draw_load_shark()   { bussin 0 - 1; }
skibidi draw_background(rizz far, rizz mid, rizz near, rizz fore, chad dist) { rizz noop = 0; }
skibidi draw_unload(rizz tex) { rizz noop = 0; }

skibidi draw_player(chad x, chad y, rizz tex, rizz frame) { rizz noop = 0; }
skibidi draw_bat(chad x, chad y, rizz tex) { rizz noop = 0; }

skibidi draw_ent(chad x, chad y, chad w, chad h, rizz kind,
                 rizz tex_pat, rizz tex_crate, rizz tex_post, rizz frame) { rizz noop = 0; }

skibidi draw_hearts(rizz hearts)   { rizz noop = 0; }
skibidi draw_speedbar(rizz lvl)    { rizz noop = 0; }
skibidi draw_hud(rizz score, rizz lvl) { rizz noop = 0; }
skibidi draw_title(chad t)         { rizz noop = 0; }
skibidi draw_gameover(rizz score, rizz seed) { rizz noop = 0; }
skibidi draw_boss(chad x, chad y, rizz kind, rizz phase,
                  rizz tex_shark, rizz tex_croc) { rizz noop = 0; }
skibidi draw_bomb(chad x, chad y, chad w, chad h, cap burning) { rizz noop = 0; }
skibidi draw_boss_bar(rizz kind, rizz bonks) { rizz noop = 0; }
