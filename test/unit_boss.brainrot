🚽 unit_boss.brainrot — src/sim.brainrot's boss half: the shared phase
🚽 machine, Tralalero's closing, Bombardiro's bombs.
🚽
🚽 Why this is a unit file rather than golden coverage: the bosses trigger
🚽 at score 5,000 and 10,000, and the headless input tape (test/platform_
🚽 fake.brainrot) is a coverage instrument, not a good player -- it dies
🚽 around 400-700. So the headless golden proves the boss code does not
🚽 disturb an ordinary run, and this file drives the fight directly.
🚽
🚽 The second half runs a real frame loop over the same functions `main`
🚽 calls, in the same order, so this is integration coverage and not just
🚽 per-function assertions.

#cooked "../src/tune.brainrot"
#cooked "../src/math.brainrot"
#cooked "../src/collide.brainrot"
#cooked "../src/curve.brainrot"
#cooked "../src/sim.brainrot"

skibidi main {
    gang World wd;
    gang Player pl;
    gang Boss bo;
    🚽 Two stand-ins for the fairness probe below: one grounded, one at jump
    🚽 apex. Only .grounded and .y are read (by shark_contact_hit).
    gang Player pg;
    gang Player pa;

    world_reset(&wd);
    player_reset(&pl);
    boss_clear(&bo);
    wd.dt = 0.016666;

    🚽 --- triggering ---------------------------------------------------
    🚽 Once per run each, and on LEVEL rather than score -- score is
    🚽 dist * 0.1 plus bonk bonus, so it says how well you are playing
    🚽 rather than how far you have got, and the boss used to arrive
    🚽 EARLIER for a better player. See t_tralalero_lvl().
    yapping("-- boss_due, by level --");
    flex (rizz l = 1; l <= 9; l = l + 1) {
        yapping("  lvl %d -> boss %d", l, boss_due(&wd, l));
    }

    boss_start(&bo, &wd, t_boss_tralalero());
    yapping("after start, shark due again %d", boss_due(&wd, 8));
    yapping("croc still due               %d", boss_due(&wd, 8));

    🚽 U Din Din is the final boss: only due once the other two are done, and
    🚽 only at his level (9). Mark both prior flags and check lvl 8 vs 9.
    wd.did_bombardiro = W;
    yapping("dindin at lvl 8 %d, at lvl 9 %d",
            boss_due(&wd, 8), boss_due(&wd, 9));

    🚽 --- the shared phase machine --------------------------------------
    yapping("-- phases --");
    yapping("start phase %d bonks %d owns_spawner %b vulnerable %b",
            bo.phase, bo.bonks, boss_owns_spawner(&bo), boss_vulnerable(&bo));

    🚽 Survive is a fixed stretch; the opening is short. Step until the
    🚽 phase flips rather than asserting a frame count, so retuning
    🚽 t_boss_survive_time() does not rewrite this test.
    rizz steps = 0;
    goon (bo.phase == t_boss_survive() && steps < 2000) {
        boss_tick(&bo, &wd);
        steps = steps + 1;
    }
    yapping("survive -> %d after %d steps (want phase %d)",
            bo.phase, steps, t_boss_open());
    yapping("opening: vulnerable %b", boss_vulnerable(&bo));

    🚽 He is still at the lurk position on the frame the phase flips -- the
    🚽 move happens over the window. What matters is that he ARRIVES inside
    🚽 it, because the whole fight is unwinnable if he does not: at
    🚽 t_boss_move_speed() he needs 180px of the 520px the window allows.
    yapping("  at flip   x %.1f", bo.x);
    steps = 0;
    goon (steps < 30) {
        boss_tick(&bo, &wd);
        steps = steps + 1;
    }
    cap reachable = boss_in_bat(&bo, &pl);
    yapping("  0.5s in   x %.1f, in bat range %b", bo.x, reachable);

    🚽 An opening that closes unpunished costs time, not health.
    steps = 0;
    goon (bo.phase == t_boss_open() && steps < 2000) {
        boss_tick(&bo, &wd);
        steps = steps + 1;
    }
    yapping("missed opening -> %d, bonks still %d", bo.phase, bo.bonks);

    🚽 --- bonks ----------------------------------------------------------
    🚽 Three, and the third sends him away with the reward.
    yapping("-- bonks --");
    bo.phase = t_boss_open();
    boss_take_bonk(&bo, &wd);
    yapping("bonk 1: bonks %d phase %d bonus %d", bo.bonks, bo.phase, wd.bonus);
    bo.phase = t_boss_open();
    boss_take_bonk(&bo, &wd);
    yapping("bonk 2: bonks %d phase %d bonus %d", bo.bonks, bo.phase, wd.bonus);
    bo.phase = t_boss_open();
    boss_take_bonk(&bo, &wd);
    yapping("bonk 3: bonks %d phase %d bonus %d", bo.bonks, bo.phase, wd.bonus);
    yapping("leaving: owns_spawner %b vulnerable %b",
            boss_owns_spawner(&bo), boss_vulnerable(&bo));

    🚽 And the exit clears him, which is what lets the next boss start.
    steps = 0;
    cap still_here = boss_active(&bo);
    goon (still_here && steps < 2000) {
        boss_tick(&bo, &wd);
        steps = steps + 1;
        still_here = boss_active(&bo);
    }
    yapping("cleared after %d steps, kind %d phase %d",
            steps, bo.kind, bo.phase);

    🚽 --- Tralalero closes on mistakes -----------------------------------
    🚽 The lurk position is a pure function of hits taken this fight, so a
    🚽 clean fight keeps him at arm's length.
    yapping("-- shark closes --");
    boss_clear(&bo);
    world_reset(&wd);
    boss_start(&bo, &wd, t_boss_tralalero());
    yapping("0 hits target x %.1f", boss_target_x(&bo, &wd));
    boss_note_hit(&bo);
    yapping("1 hit  target x %.1f", boss_target_x(&bo, &wd));
    boss_note_hit(&bo);
    boss_note_hit(&bo);
    yapping("3 hits target x %.1f", boss_target_x(&bo, &wd));

    🚽 --- the boss's own gaps must be jumpable ---------------------------
    🚽
    🚽 A jump commits the player for 2 * |t_jump_v()| / t_gravity() seconds.
    🚽 A jump-to-jump gap shorter than that is not hard, it is impossible --
    🚽 the next obstacle arrives before the player has landed from the last.
    🚽
    🚽 The boss spawner used to set a flat 0.72s and never call fair_clamp()
    🚽 at all, against a 0.769s airtime, while spawning ONLY crates and
    🚽 posts. Every gap in the Tralalero fight was jump-to-jump and 49ms too
    🚽 short. It was unclearable by construction, and no test noticed because
    🚽 nothing asked what gap the boss actually produced.
    yapping("-- boss gaps are jumpable --");
    chad airtime = 2.0 * absf(t_jump_v()) / t_gravity();
    yapping("airtime %.3f s", airtime);

    boss_clear(&bo);
    world_reset(&wd);
    boss_start(&bo, &wd, t_boss_tralalero());

    cap all_ok = W;
    flex (rizz prev = 0; prev <= 2; prev = prev + 1) {
        flex (rizz next = 0; next <= 2; next = next + 1) {
            bo.prev_kind = prev;
            chad gap = boss_spawn_gap(&bo, next);
            cap jj = kind_is_jump(prev) && kind_is_jump(next);
            edgy (jj) {
                edgy (gap <= airtime) { all_ok = L; }
            }
            yapping("  prev %d -> next %d: gap %.3f  jump->jump %b  slack %+.3f",
                    prev, next, gap, jj, gap - airtime);
        }
    }
    yapping("every boss jump->jump gap clears the airtime: %b", all_ok);

    🚽 --- Bombardiro's ordnance -------------------------------------------
    yapping("-- bombs --");
    boss_clear(&bo);
    world_reset(&wd);
    wd.dt = 0.016666;
    boss_start(&bo, &wd, t_boss_bombardiro());

    gang Bomb shell;
    bomb_spawn(&shell, &bo);
    yapping("spawned at y %.1f, w %.1f (shell)", shell.y, bomb_w(&shell));

    🚽 Falls under the same gravity the player does, then detonates into a
    🚽 wider, shorter box sitting on the ground line.
    steps = 0;
    goon (shell.fuse <= 0.0 && steps < 2000) {
        bomb_tick(&shell, &wd);
        steps = steps + 1;
    }
    yapping("landed after %d steps at y %.1f, w %.1f (blast)",
            steps, shell.y, bomb_w(&shell));
    yapping("ground line %.1f, blast bottom %.1f",
            t_ground_y(), shell.y + bomb_h(&shell));

    🚽 The blast is not permanent.
    steps = 0;
    goon (shell.alive && steps < 2000) {
        bomb_tick(&shell, &wd);
        steps = steps + 1;
    }
    yapping("blast gone after %d more steps", steps);

    🚽 A bomb landing on the player's column hits; one landing behind does
    🚽 not. The player box is t_player_x() for t_player_w().
    gang Bomb hit;
    bomb_spawn(&hit, &bo);
    hit.x = t_player_x();
    hit.y = pl.y;
    yapping("bomb on the player  %b", bomb_hits_player(&hit, &pl));
    hit.x = t_player_x() - 400.0;
    yapping("bomb well behind    %b", bomb_hits_player(&hit, &pl));

    🚽 --- a bomb has to be dodgeable, and has to threaten ------------------
    🚽
    🚽 Reported from play: "bombardillo practically insta kills me every time,
    🚽 I can't see where the bombs are coming from, they fall too fast and
    🚽 there is no shadow."
    🚽
    🚽 All three were measurable. The fall took 0.535s under t_gravity() while
    🚽 a jump lasts 0.769s, so a jump started the instant the bomb appeared
    🚽 finished AFTER it had already detonated. The player could not react,
    🚽 only pre-empt -- and there was nothing to pre-empt from, because an
    🚽 11px shell of rgb(34,34,40) against a rgb(12,14,34) sky is invisible.
    yapping("-- bombs: dodgeable, and still a threat --");
    chad air  = 2.0 * absf(t_jump_v()) / t_gravity();
    chad need = 0.25 + air / 2.0;
    yapping("  fall %.3fs   need %.3fs (0.25 react + %.3f to apex)   slack %+.3f",
            t_bomb_fall_time(), need, air / 2.0, t_bomb_fall_time() - need);
    cap dodgeable = t_bomb_fall_time() > need;
    yapping("  a bomb can be reacted to: %b", dodgeable);

    🚽 Dodgeable is only half of it. The bomb has to land AHEAD of Tung, far
    🚽 enough that the blast is not already on him when it appears, and near
    🚽 enough that it still reaches him before its fuse burns out. Both ends
    🚽 are seconds, not pixels -- the hazard closes at world speed -- so this
    🚽 must hold at every speed the fight can happen at.
    boss_clear(&bo);
    world_reset(&wd);
    boss_start(&bo, &wd, t_boss_bombardiro());
    bo.phase = t_boss_survive();
    cap always_ahead = W;
    cap always_arrives = W;
    yapping("  lead must be >= %.2fs (react + clear the blast) and <= %.2fs (fuse)",
            t_bomb_lead_min(), t_bomb_fuse());
    flex (rizz sp = 620; sp <= 900; sp = sp + 70) {
        wd.speed = sp;
        wd.dist  = 0.0;
        bo.x = boss_target_x(&bo, &wd);
        bo.y = t_croc_cruise_y();
        gang Bomb probe;
        bomb_spawn(&probe, &bo);
        chad lx   = bomb_landing_x(&probe, &wd);
        chad lead = croc_bomb_lead(&bo, &wd);
        edgy (lead < t_bomb_lead_min()) { always_ahead = L; }
        edgy (lead > t_bomb_fuse()) { always_arrives = L; }
        yapping("  speed %3d: croc x %6.0f -> bomb lands x %6.0f, lead %.2fs",
                sp, bo.x, lx, lead);
    }
    yapping("  never lands on Tung: %b    always reaches him: %b",
            always_ahead, always_arrives);

    🚽 A constant lead would put every blast on Tung at the same beat, which
    🚽 is one memorised jump on a loop. The sway wanders the lead, so show the
    🚽 window it actually wanders over rather than asserting it in a comment.
    wd.speed = 710.0;
    chad lo = 99999.0;
    chad hi = 0.0 - 99999.0;
    flex (rizz k = 0; k < 12; k = k + 1) {
        wd.dist = k * 120.0;
        bo.x = boss_target_x(&bo, &wd);
        chad ld = croc_bomb_lead(&bo, &wd);
        edgy (ld < lo) { lo = ld; }
        edgy (ld > hi) { hi = ld; }
    }
    yapping("  sway wanders the lead over %.2f..%.2fs, inside %.2f..%.2f: %b",
            lo, hi, t_bomb_lead_min(), t_bomb_fuse(),
            lo >= t_bomb_lead_min() && hi <= t_bomb_fuse());

    🚽 --- there is an input that survives every bomb he drops ----------------
    🚽
    🚽 Two reports from play, one fight:
    🚽   "the bombs fall immediately where the player is, they aren't
    🚽    following the laws of physics"
    🚽   "sometimes a bomb locks in with the player position and it becomes
    🚽    impossible to dodge"
    🚽
    🚽 Both were true, and neither was a feeling:
    🚽
    🚽   - bomb_gravity() is derived from ONE drop, the bay at cruising height,
    🚽     but bombs were released wherever the croc happened to be. At the
    🚽     opening he is at t_croc_open_y(), which puts the bay BELOW the
    🚽     shell's own landing line -- so bomb_tick() detonated it on its first
    🚽     tick. No arc, and the marker that is supposed to warn you drawn for
    🚽     one frame.
    🚽   - He hovered over Tung's column. A falling shell keeps its column and
    🚽     Tung cannot move, so that bomb is welded to him: stand and it lands
    🚽     on you, jump and you rise into it.
    🚽
    🚽 So this does not test the mechanism -- mechanisms move. It tests the
    🚽 PROPERTY, and it tests it the only way that cannot be fooled: run the
    🚽 fight the way main runs it, and for every shell it lets go, brute-force
    🚽 every input a player has. Press jump on frame 0, on frame 1, ... or
    🚽 never press at all. At least one of them has to come out unhurt.
    🚽
    🚽 Run against the hovering croc, columns 200-240 scored 0 survivable
    🚽 timings out of 181. Not hard -- impossible.
    yapping("-- every bomb has an input that survives it --");
    boss_clear(&bo);
    world_reset(&wd);
    boss_start(&bo, &wd, t_boss_bombardiro());
    wd.dt = 0.016666;

    🚽 The two halves of the gate, at the positions he actually flies. The
    🚽 ground trigger is what bomb_tick() compares the shell against, so a bay
    🚽 below it is a bomb that has already landed.
    yapping("  ground trigger y %.0f, Tung's column %.0f..%.0f",
            t_ground_y() - t_bomb_h(), t_player_x(), t_player_x() + t_player_w());
    wd.speed = 700.0;
    bo.x = boss_target_x(&bo, &wd);
    bo.y = t_croc_cruise_y();
    yapping("  cruising: bay y %.0f, lead %.2fs -> may spawn %b",
            bo.y + t_croc_h(), croc_bomb_lead(&bo, &wd),
            boss_may_spawn(&bo, &wd));
    bo.y = t_croc_open_y();
    bo.x = t_croc_open_x();
    yapping("  opening:  bay y %.0f, lead %.2fs -> may spawn %b",
            bo.y + t_croc_h(), croc_bomb_lead(&bo, &wd),
            boss_may_spawn(&bo, &wd));

    🚽 At the speed the fight actually happens at. world_reset() starts at
    🚽 t_speed_start(), and running the croc there would test a fight nobody
    🚽 plays -- he arrives at t_bombardiro_lvl(), which speed_to_lvl() puts at
    🚽 710px/s and climbing. Everything about the lead is in seconds, so this
    🚽 SHOULD not matter; running it at the wrong speed is how you never find
    🚽 out that it does.
    boss_clear(&bo);
    world_reset(&wd);
    wd.dt = 0.016666;
    rizz warm = 0;
    rizz at_lvl = speed_to_lvl(wd.speed);
    goon (at_lvl < t_bombardiro_lvl() && warm < 200000) {
        world_advance(&wd);
        warm = warm + 1;
        at_lvl = speed_to_lvl(wd.speed);
    }
    boss_start(&bo, &wd, t_boss_bombardiro());
    yapping("  fight runs at lvl %d, speed %.0f, croc x %.0f",
            at_lvl, wd.speed, bo.x);

    rizz drops    = 0;
    rizz shortest = 99999;
    rizz longest  = 0;
    rizz worst    = 99999;
    rizz easiest  = 0;
    rizz sampled  = 0;
    chad tightest = 99999.0;
    flex (rizz bf = 0; bf < 1800; bf = bf + 1) {
        world_advance(&wd);
        boss_tick(&bo, &wd);

        cap owns = boss_owns_spawner(&bo);
        cap may  = boss_may_spawn(&bo, &wd);
        edgy (owns && may) {
            bo.spawn_t = bo.spawn_t - wd.dt;
            edgy (bo.spawn_t <= 0.0) {
                bo.spawn_t = t_bomb_interval();
                drops = drops + 1;

                🚽 Fly it to the ground on its own clock and count the ticks.
                gang Bomb shot;
                gang World wf;
                world_reset(&wf);
                wf.dt    = wd.dt;
                wf.speed = wd.speed;
                bomb_spawn(&shot, &bo);
                rizz air_f = 0;
                goon (shot.fuse <= 0.0 && air_f < 1000) {
                    bomb_tick(&shot, &wf);
                    air_f = air_f + 1;
                }
                edgy (air_f < shortest) { shortest = air_f; }
                edgy (air_f > longest)  { longest  = air_f; }

                🚽 Now the same shell against every jump timing there is.
                🚽
                🚽 j = -1 is "never press", which is the honest baseline: a
                🚽 bomb that lands behind Tung is survived by doing nothing,
                🚽 and that is a light show rather than a threat. It stays in
                🚽 the sweep whatever the step is.
                🚽
                🚽 Sampled every 3rd frame rather than every frame. The window
                🚽 that survives is ~32 frames wide, so a 3-frame step samples
                🚽 it about eleven times over and cannot step across it -- and
                🚽 the full-resolution sweep put unit_boss at 68s on its own,
                🚽 which is too much gate for the certainty it added.
                rizz step  = 3;
                rizz lived = 0;
                rizz tries = 0;
                flex (rizz j = 0 - 1; j < 180; j = j + step) {
                    gang World wj;
                    gang Player pj;
                    gang Bomb bj;
                    world_reset(&wj);
                    player_reset(&pj);
                    wj.dt    = wd.dt;
                    wj.speed = wd.speed;
                    bomb_spawn(&bj, &bo);

                    cap stung = L;
                    rizz t = 0;
                    cap airborne = bj.alive;
                    goon (airborne && t < 300) {
                        edgy (t == j) { player_jump(&pj); }
                        player_physics(&pj, &wj);
                        player_tick_timers(&pj, &wj);
                        bomb_tick(&bj, &wj);
                        cap touch = bomb_hits_player(&bj, &pj);
                        edgy (touch) { stung = W; }
                        t = t + 1;
                        airborne = bj.alive;
                    }
                    tries = tries + 1;
                    edgy (!stung) { lived = lived + 1; }
                }
                sampled = tries;
                edgy (lived < worst)   { worst   = lived; }
                edgy (lived > easiest) { easiest = lived; }
                🚽 The surviving timings are contiguous, so counting them and
                🚽 multiplying back out by the step is the width of the window
                🚽 a player actually has to hit.
                chad win = lived * step * wd.dt;
                edgy (win < tightest) { tightest = win; }
            }
        }
    }
    chad short_s = shortest * 0.016666;
    chad long_s  = longest * 0.016666;
    yapping("  %d bombs released over 30s of fight", drops);
    yapping("  fall %.2fs .. %.2fs (tuned %.2fs)",
            short_s, long_s, t_bomb_fall_time());

    🚽 The floor from t_bomb_fall_time()'s own note: react, then reach apex.
    cap all_dodgeable = short_s > need;
    yapping("  the shortest fall clears the %.3fs reaction floor: %b",
            need, all_dodgeable);

    yapping("  survivable timings per bomb: worst %d, best %d, of %d sampled",
            worst, easiest, sampled);
    yapping("  tightest dodge window: %.2fs", tightest);
    cap always_beatable = worst > 0;
    cap never_free      = easiest < sampled;
    yapping("  EVERY bomb has a way out: %b", always_beatable);
    yapping("  and none of them is free:  %b", never_free);
    cap he_still_bombs = drops > 0;
    yapping("  he is still bombing:       %b", he_still_bombs);

    🚽 --- integration: a scripted fight ------------------------------------
    🚽 The same calls main makes, in the same order, driven by a script
    🚽 that swings whenever the boss is open. Three openings, three bonks,
    🚽 boss gone -- with no input tape and no window.
    yapping("-- scripted fight --");
    boss_clear(&bo);
    world_reset(&wd);
    player_reset(&pl);
    wd.dt = 0.016666;
    boss_start(&bo, &wd, t_boss_tralalero());

    🚽 Every `cap`-returning call lands in a local before it is tested.
    🚽 `edgy (boss_vulnerable(&bo))` is not equivalent -- it errors and
    🚽 takes the FALSE branch, so this loop would spin to its cap having
    🚽 done nothing (brainrot#313). The same convention holds in
    🚽 src/main.brainrot, where it reads like style and is not.
    rizz swings = 0;
    rizz frames = 0;
    cap  fighting = boss_active(&bo);
    goon (fighting && frames < 6000) {
        world_advance(&wd);
        player_physics(&pl, &wd);
        player_tick_timers(&pl, &wd);
        boss_tick(&bo, &wd);

        🚽 Swing on sight of an opening. player_swing() refuses while the
        🚽 attack timer runs, so this cannot machine-gun the boss.
        cap open_now = boss_vulnerable(&bo);
        edgy (open_now) {
            player_swing(&pl);
            swings = swings + 1;
        }

        cap swinging = player_swinging(&pl);
        edgy (swinging) {
            edgy (open_now) {
                cap bonk = boss_in_bat(&bo, &pl);
                edgy (bonk) { boss_take_bonk(&bo, &wd); }
            }
        }
        frames = frames + 1;
        fighting = boss_active(&bo);
    }
    yapping("fight over in %d frames, %d swing attempts", frames, swings);
    yapping("boss kind %d, hearts %d, bonus %d", bo.kind, pl.hearts, wd.bonus);

    🚽 --- the fairness invariant --------------------------------------------
    🚽
    🚽 The player is pinned at t_player_x() and can only jump, so the rule is:
    🚽 EVERY frame must leave a safe vertical position. Two bosses, two shapes
    🚽 of the same rule:
    🚽
    🚽   Bombardiro never positions its BODY into Tung at all -- it hurts only
    🚽   through dodgeable bombs -- so for the croc, boss_hits_body() must be
    🚽   false on every frame (the original invariant, unchanged).
    🚽
    🚽   Tralalero's body IS the threat: he charges low (jump it) and crosses
    🚽   high (duck it). That is fair only if the two never coincide -- so the
    🚽   probe hits a grounded stand-in AND an apex stand-in each frame, and an
    🚽   "un-dodgeable frame" (both hit at once, no safe input) must never
    🚽   happen. shark_contact_hit()'s phase split is what guarantees it.
    yapping("-- no unavoidable contact --");

    flex (rizz which = 1; which <= 3; which = which + 1) {
        boss_clear(&bo);
        world_reset(&wd);
        player_reset(&pl);
        wd.dt = 0.016666;
        boss_start(&bo, &wd, which);

        rizz touches = 0;
        rizz unfair = 0;
        rizz openings = 0;
        rizz worst_hits = 0;
        chad nearest = 99999.0;
        rizz f = 0;
        cap up = boss_active(&bo);
        goon (up && f < 6000) {
            world_advance(&wd);
            player_physics(&pl, &wd);
            player_tick_timers(&pl, &wd);
            boss_tick(&bo, &wd);

            cap touching = boss_hits_body(&bo, &pl);
            edgy (touching) { touches = touches + 1; }

            🚽 Tralalero fairness: would BOTH a grounded and an apex player be
            🚽 hit this frame? If so there was no safe input -- must never be.
            edgy (which == t_boss_tralalero()) {
                pg.grounded = W;
                pg.y = t_ground_y() - t_player_h();
                pa.grounded = L;
                pa.y = t_ground_y() - t_player_h() - 190.0;
                edgy (shark_contact_hit(&bo, &pg) && shark_contact_hit(&bo, &pa)) {
                    unfair = unfair + 1;
                }
            }
            🚽 U Din Din fairness: same probe. He only hits a grounded player
            🚽 (low charge), so an apex player is always safe -- unfair == 0.
            edgy (which == t_boss_dimdim()) {
                pg.grounded = W;
                pg.y = t_ground_y() - t_player_h();
                pa.grounded = L;
                pa.y = t_ground_y() - t_player_h() - 190.0;
                edgy (dindin_contact_hit(&bo, &pg) && dindin_contact_hit(&bo, &pa)) {
                    unfair = unfair + 1;
                }
            }

            🚽 The smallest gap between Tung's back and the boss's nose.
            🚽 Negative means the boss is in FRONT of him, which is where an
            🚽 opening happens -- the bat only reaches forward.
            chad gap = t_player_x() - (bo.x + boss_w(bo.kind));
            edgy (gap < nearest) { nearest = gap; }
            edgy (bo.hits > worst_hits) { worst_hits = bo.hits; }

            cap can = boss_vulnerable(&bo);
            edgy (can) {
                openings = openings + 1;
                player_swing(&pl);
            }
            cap sw = player_swinging(&pl);
            edgy (sw) {
                edgy (can) {
                    cap hit = boss_in_bat(&bo, &pl);
                    edgy (hit) { boss_take_bonk(&bo, &wd); }
                }
            }
            🚽 Every mistake drags the shark closer, so make some.
            edgy (f % 900 == 0) {
                player_take_hit(&pl, &wd);
                boss_note_hit(&bo);
                pl.hearts = t_hearts_max();
                pl.iframe_t = 0.0;
            }
            f = f + 1;
            up = boss_active(&bo);
        }
        edgy (which == t_boss_tralalero() || which == t_boss_dimdim()) {
            yapping("boss %d: %d frames, %d open frames, un-dodgeable frames %d (must be 0)",
                    which, f, openings, unfair);
        }
        amogus {
            yapping("boss %d: %d frames, %d open frames, body contacts %d (must be 0)",
                    which, f, openings, touches);
        }
        🚽 bo.hits is read from worst_hits, not the boss: the loop exits
        🚽 after boss_clear() has zeroed it.
        yapping("        nose got within %.0fpx of Tung's back (negative = in front)",
                nearest);
        yapping("        mistakes made during the fight: %d", worst_hits);
    }

    🚽 --- the opening has to be long enough to USE -------------------------
    🚽
    🚽 "Can the bat reach him at all" was the only thing asked before, and it
    🚽 passed on a fight nobody could win. Tralalero spends 0.78s of his lunge
    🚽 rising, crossing over Tung and landing, and the opening's clock used to
    🚽 run through all of it -- so of a 61-frame window he was inside bat reach
    🚽 for the last 14. React to "he is open!", swing, hit nothing, and the
    🚽 0.45s attack cooldown eats the only part that counted.
    🚽
    🚽 So measure the window that actually exists, not the one the phase
    🚽 timer claims. It must be at least t_boss_open_time().
    yapping("-- how long is an opening, really --");
    flex (rizz k = 1; k <= 2; k = k + 1) {
        boss_clear(&bo);
        world_reset(&wd);
        player_reset(&pl);
        wd.dt = 0.016666;
        boss_start(&bo, &wd, k);

        rizz phase_f = 0;
        rizz reach_f = 0;
        rizz g = 0;
        cap seen = L;
        cap alive2 = boss_active(&bo);
        goon (alive2 && g < 3000 && !seen) {
            world_advance(&wd);
            player_physics(&pl, &wd);
            player_tick_timers(&pl, &wd);
            boss_tick(&bo, &wd);
            cap opening = boss_vulnerable(&bo);
            edgy (opening) {
                phase_f = phase_f + 1;
                cap reach = boss_in_bat(&bo, &pl);
                edgy (reach) { reach_f = reach_f + 1; }
            }
            amogus {
                edgy (phase_f > 0) { seen = W; }
            }
            g = g + 1;
            alive2 = boss_active(&bo);
        }
        chad secs = reach_f * 0.016666;
        yapping("boss %d: opening %d frames, in bat reach %d of them (%.2fs)",
                k, phase_f, reach_f, secs);
        yapping("        t_boss_open_time() is %.2fs -- reach must not be less",
                t_boss_open_time());
    }

    🚽 And the shark's closing is clamped, so no number of mistakes walks him
    🚽 into the player even if t_hearts_max() grows later.
    yapping("-- shark closing is clamped --");
    boss_clear(&bo);
    world_reset(&wd);
    boss_start(&bo, &wd, t_boss_tralalero());
    flex (rizz h = 0; h <= 12; h = h + 4) {
        bo.hits = h;
        chad lx = boss_lurk_x(&bo);
        yapping("  %2d hits -> lurk x %6.0f, nose %6.0f, Tung's back %.0f",
                h, lx, lx + t_shark_w(), t_player_x());
    }

    bussin 0;
}
