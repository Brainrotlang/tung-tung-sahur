🚽 draw.brainrot — every rl_draw_* call in the game lives here.
🚽
🚽 M0 renders in primitives. Sprite atlases need rl_draw_texture_rec
🚽 upstream (DESIGN.md B2), and one PNG per animation frame would mean six
🚽 texture handles for a run cycle alone. Rectangles ship a playable game
🚽 with no upstream blockers, which is the whole point of M0.
🚽
🚽 Numeric HUD text arrived upstream as rl_draw_text_int /
🚽 rl_measure_text_int (DESIGN.md B1, Brainrotlang/brainrot#292), so the
🚽 score, level and final score are drawn rather than printed to the
🚽 console. See DESIGN.md section 10.3.
🚽
🚽 Requires `#cooked <raylib>` earlier in the including file.

skibidi draw_begin() {
    rl_begin_drawing();
}

skibidi draw_end() {
    rl_end_drawing();
}

skibidi draw_sky(rizz lvl) {
    rl_clear_background(sky_r(lvl), sky_g(lvl), sky_b(lvl), 255);
}

skibidi draw_ground() {
    chad g = t_ground_y();
    rl_draw_rectangle(0, g, t_screen_w(), t_screen_h() - g, 34, 28, 24, 255);
    rl_draw_rectangle(0, g, t_screen_w(), 6, 58, 48, 38, 255);
}

🚽 --- sprite loading ---
🚽 One loader per atlas, each returning a handle or -1. Hardcoding the paths
🚽 here rather than passing them in keeps every rl_* call inside this file,
🚽 which is the rule that lets the headless harness swap the whole layer out.
rizz draw_load_run()   { bussin rl_load_texture("assets/tung_run.png"); }
rizz draw_load_jump()  { bussin rl_load_texture("assets/tung_jump.png"); }
rizz draw_load_swing() { bussin rl_load_texture("assets/tung_swing.png"); }
rizz draw_load_patapim() { bussin rl_load_texture("assets/patapim_run.png"); }
rizz draw_load_crate() { bussin rl_load_texture("assets/crate.png"); }
rizz draw_load_post()  { bussin rl_load_texture("assets/post.png"); }
rizz draw_load_bg_far()  { bussin rl_load_texture("assets/bg_far.png"); }
rizz draw_load_bg_mid()  { bussin rl_load_texture("assets/bg_mid.png"); }
rizz draw_load_bg_near() { bussin rl_load_texture("assets/bg_near.png"); }
rizz draw_load_bg_fore() { bussin rl_load_texture("assets/bg_fore.png"); }

skibidi draw_unload(rizz tex) {
    edgy (tex >= 0) { rl_unload_texture(tex); }
}

🚽 Tung himself.
🚽
🚽 `tex` is an atlas handle and `frame` an index into it. A negative handle
🚽 means the art is missing, and the game falls back to the M0 rectangle
🚽 rather than drawing nothing -- someone who clones this without the assets
🚽 should get a playable game, not an invisible player.
🚽
🚽 The sprite is wider than the collision box, so it is drawn offset by the
🚽 torso anchor. Its bottom row is the contact row, so y needs no offset at
🚽 all: the feet land exactly where the physics puts them.
skibidi draw_player(chad x, chad y, rizz tex, rizz frame) {
    edgy (tex < 0) {
        rl_draw_rectangle(x, y, t_player_w(), t_player_h(), 196, 148, 92, 255);
        rl_draw_rectangle(x + 8.0, y + 18.0, 10.0, 10.0, 30, 22, 16, 255);
        rl_draw_rectangle(x + 30.0, y + 18.0, 10.0, 10.0, 30, 22, 16, 255);
        rl_draw_rectangle(x + 12.0, y + 46.0, 24.0, 6.0, 30, 22, 16, 255);
    }
    amogus {
        chad sw = t_sprite_w();
        rl_draw_texture_rec(tex, frame * sw, 0.0, sw, t_sprite_h(),
                            x + t_player_w() / 2.0 - t_sprite_anchor(), y,
                            255, 255, 255, 255);
    }
}

🚽 The bat hitbox, as a rectangle.
🚽
🚽 Only drawn when the sprite atlas is missing. With the art loaded the bat
🚽 is part of the swing frames, and the drawn bat is about 18px shorter than
🚽 this box -- so the reach is slightly more generous than it looks. See
🚽 DESIGN.md 10.1.
skibidi draw_bat(chad x, chad y, rizz tex) {
    edgy (tex < 0) {
        rl_draw_rectangle(x + t_hitbox_dx(), y + t_hitbox_dy(),
                          t_hitbox_w(), t_hitbox_h(), 240, 220, 120, 255);
    }
}

🚽 An obstacle or an enemy. Each kind has its own atlas handle and its own
🚽 frame width and anchor, printed by tools/process_sprites.py -- the art is
🚽 not the same width as the collision box, so the draw offsets by the
🚽 anchor rather than using the entity's x.
🚽
🚽 A negative handle falls back to the M0 rectangle, per kind, so a partial
🚽 set of assets degrades one entity at a time instead of all at once.
skibidi draw_ent(chad x, chad y, chad w, chad h, rizz kind,
                 rizz tex_pat, rizz tex_crate, rizz tex_post, rizz frame) {
    edgy (kind == t_kind_patapim()) {
        edgy (tex_pat >= 0) {
            🚽 NEGATIVE source width, which mirrors the frame.
            🚽
            🚽 Every sprite is authored facing right, because that is the
            🚽 cheaper half: rl_draw_texture_rec flips on the sign of the
            🚽 source rectangle, so one direction is free. Tung runs right
            🚽 and needs no flip. Patapim charges LEFT at the player, so
            🚽 without this it runs backwards -- tail first, at the thing
            🚽 it is supposed to be attacking.
            chad pw = t_patapim_w();
            rl_draw_texture_rec(tex_pat, frame * pw, 0.0, 0.0 - pw,
                                t_patapim_h(),
                                x + w / 2.0 - t_patapim_anchor(), y,
                                255, 255, 255, 255);
        }
        amogus {
            rl_draw_rectangle(x, y, w, h, 150, 80, 44, 255);
            rl_draw_rectangle(x + 10.0, y + 16.0, 12.0, 12.0, 240, 240, 240, 255);
            rl_draw_rectangle(x + 40.0, y + 16.0, 12.0, 12.0, 240, 240, 240, 255);
            rl_draw_rectangle(x + 14.0, y + 42.0, 36.0, 8.0, 40, 20, 12, 255);
        }
    }
    amogus {
        edgy (kind == t_kind_post()) {
            edgy (tex_post >= 0) {
                rl_draw_texture_rec(tex_post, 0.0, 0.0, 21.0, 96.0,
                                    x + w / 2.0 - 10.0, y, 255, 255, 255, 255);
            }
            amogus {
                rl_draw_rectangle(x, y, w, h, 120, 110, 96, 255);
                rl_draw_rectangle(x, y, w, 8.0, 150, 138, 120, 255);
            }
        }
        amogus {
            edgy (tex_crate >= 0) {
                rl_draw_texture_rec(tex_crate, 0.0, 0.0, 46.0, 48.0,
                                    x + w / 2.0 - 22.0, y, 255, 255, 255, 255);
            }
            amogus {
                rl_draw_rectangle(x, y, w, h, 96, 92, 100, 255);
                rl_draw_rectangle(x + 4.0, y + 4.0, w - 8.0, h - 8.0, 76, 72, 80, 255);
            }
        }
    }
}

🚽 One parallax layer, tiled across the screen and scrolled at a fraction
🚽 of the world's speed.
🚽
🚽 Each layer is authored at its own width and repeated, rather than being
🚽 one screen-wide image: the apparent HEIGHT of a layer is a composition
🚽 decision, and how many times it repeats to fill 1280px is not. Scaling
🚽 them to the screen width instead produced a foliage band 472px tall
🚽 against a 96px character, which buried the entire scene.
🚽
🚽 `rate` below 1.0 makes the layer lag the ground, which is the parallax.
skibidi draw_layer(rizz tex, chad dist, chad rate, chad lw, chad lh,
                   chad bottom) {
    edgy (tex >= 0) {
        chad shift = dist * rate;
        rizz whole = shift / lw;
        chad off = shift - whole * lw;
        chad y = bottom - lh;
        chad x = 0.0 - off;
        goon (x < t_screen_w()) {
            rl_draw_texture_rec(tex, 0.0, 0.0, lw, lh, x, y, 255, 255, 255, 255);
            x = x + lw;
        }
    }
}

🚽 The four layers, back to front. Rates are the design's: distant hills
🚽 barely move, foliage at the player's feet moves with the ground.
skibidi draw_background(rizz far, rizz mid, rizz near, rizz fore, chad dist) {
    chad g = t_ground_y();
    draw_layer(far,  dist, t_bg_far_rate(),  t_bg_far_w(),  t_bg_far_h(),  g);
    draw_layer(mid,  dist, t_bg_mid_rate(),  t_bg_mid_w(),  t_bg_mid_h(),  g);
    draw_layer(near, dist, t_bg_near_rate(), t_bg_near_w(), t_bg_near_h(), g);
    draw_layer(fore, dist, t_bg_fore_rate(), t_bg_fore_w(), t_bg_fore_h(),
               g + t_bg_fore_drop());
}

skibidi draw_hearts(rizz hearts) {
    flex (rizz i = 0; i < hearts; i = i + 1) {
        rl_draw_rectangle(20 + i * 28, 20, 20, 20, 220, 60, 60, 255);
    }
}

🚽 Eight segments, one per level, matching speed_to_lvl's range.
skibidi draw_speedbar(rizz lvl) {
    rl_draw_text("SPEED", 1064, 18, 20, 220, 220, 220, 255);
    flex (rizz i = 0; i < 8; i = i + 1) {
        edgy (i < lvl) {
            rl_draw_rectangle(1136 + i * 16, 18, 12, 20, 240, 150, 40, 255);
        }
        amogus {
            rl_draw_rectangle(1136 + i * 16, 18, 12, 20, 60, 56, 52, 255);
        }
    }
}

🚽 Score is zero-padded to six columns so the number keeps a fixed width
🚽 as it grows -- a HUD that reflows every time you cross a power of ten is
🚽 the thing `pad` exists to prevent.
skibidi draw_hud(rizz score, rizz lvl) {
    rl_draw_text_int("SCORE ", score, 6, 20, 52, 20, 220, 200, 120, 255);
    rl_draw_text_int("LVL ", lvl, 0, 1064, 46, 20, 220, 220, 220, 255);
}

🚽 The title beat: TUNG... TUNG... TUNG... SAHUR, one word at a time.
skibidi draw_title(chad t) {
    rizz cx = t_screen_w() / 2;

    edgy (t > 0.0) {
        rizz w1 = rl_measure_text("TUNG...", 64);
        rl_draw_text("TUNG...", cx - w1 / 2, 150, 64, 200, 170, 120, 255);
    }
    edgy (t > 0.5) {
        rizz w2 = rl_measure_text("TUNG...", 64);
        rl_draw_text("TUNG...", cx - w2 / 2, 220, 64, 210, 180, 130, 255);
    }
    edgy (t > 1.0) {
        rizz w3 = rl_measure_text("TUNG...", 64);
        rl_draw_text("TUNG...", cx - w3 / 2, 290, 64, 220, 190, 140, 255);
    }
    edgy (t > 1.5) {
        rizz w4 = rl_measure_text("SAHUR", 96);
        rl_draw_text("SAHUR", cx - w4 / 2, 360, 96, 245, 200, 90, 255);
    }
    edgy (t > 2.2) {
        rizz w5 = rl_measure_text("SPACE to run   X to TUNG   ESC to quit", 24);
        rl_draw_text("SPACE to run   X to TUNG   ESC to quit",
                     cx - w5 / 2, 480, 24, 190, 190, 190, 255);
    }
}

🚽 The seed is on screen because a run is reproducible from it: a bug
🚽 report is a seed and a frame number, and asking someone to go read their
🚽 terminal for it never worked.
skibidi draw_gameover(rizz score, rizz seed) {
    rizz cx = t_screen_w() / 2;
    rl_draw_rectangle(0, 232, t_screen_w(), 216, 0, 0, 0, 190);

    rizz w1 = rl_measure_text("GAME OVER", 80);
    rl_draw_text("GAME OVER", cx - w1 / 2, 258, 80, 230, 70, 60, 255);

    rizz w2 = rl_measure_text_int("SCORE ", score, 0, 36);
    rl_draw_text_int("SCORE ", score, 0, cx - w2 / 2, 350, 36,
                     245, 200, 90, 255);

    rizz w3 = rl_measure_text_int("seed ", seed, 0, 18);
    rl_draw_text_int("seed ", seed, 0, cx - w3 / 2, 396, 18,
                     140, 140, 140, 255);

    rizz w4 = rl_measure_text("R or SPACE to run again", 24);
    rl_draw_text("R or SPACE to run again", cx - w4 / 2, 420, 24,
                 210, 210, 210, 255);
}

🚽 --- bosses ---------------------------------------------------------------
🚽
🚽 Primitives, deliberately. There is no shark or crocodile art yet, and M0
🚽 proved the game reads fine in rectangles -- so the fight ships playable
🚽 and the atlases drop in later behind the same `tex >= 0` fallback every
🚽 other draw here already uses. Nothing in the simulation knows or cares.

skibidi draw_boss(chad x, chad y, rizz kind, rizz phase, rizz tex) {
    chad w = boss_w(kind);
    chad h = boss_h(kind);

    edgy (tex >= 0) {
        🚽 Both bosses face LEFT at the player, so both want the mirror.
        rl_draw_texture_rec(tex, 0.0, 0.0, 0.0 - w, h,
                            x, y, 255, 255, 255, 255);
    }
    amogus {
        edgy (kind == t_boss_tralalero()) {
            🚽 A shark on three shoes. Grey body, pale belly, one eye, and
            🚽 the legs that make him the joke.
            rl_draw_rectangle(x, y, w, h - 22.0, 96, 108, 120, 255);
            rl_draw_rectangle(x, y + h * 0.45, w * 0.82, h * 0.30,
                              206, 210, 214, 255);
            rl_draw_rectangle(x + w * 0.55, y - 16.0, w * 0.18, 18.0,
                              96, 108, 120, 255);
            rl_draw_rectangle(x + 14.0, y + 18.0, 12.0, 12.0, 250, 250, 250, 255);
            rl_draw_rectangle(x + 16.0, y + 21.0, 6.0, 6.0, 20, 20, 20, 255);
            flex (rizz i = 0; i < 3; i = i + 1) {
                chad sx = x + 20.0 + i * 38.0;
                rl_draw_rectangle(sx, y + h - 22.0, 12.0, 16.0, 70, 60, 54, 255);
                rl_draw_rectangle(sx - 4.0, y + h - 8.0, 26.0, 10.0,
                                  240, 240, 240, 255);
            }
        }
        amogus {
            🚽 A crocodile with wings and a bomb bay.
            rl_draw_rectangle(x, y, w, h, 84, 124, 78, 255);
            rl_draw_rectangle(x, y + h * 0.62, w * 0.9, h * 0.24,
                              196, 206, 170, 255);
            rl_draw_rectangle(x - 26.0, y + 10.0, 30.0, 20.0, 84, 124, 78, 255);
            rl_draw_rectangle(x + w * 0.2, y - 14.0, w * 0.6, 14.0,
                              120, 120, 128, 255);
            rl_draw_rectangle(x + 12.0, y + 14.0, 12.0, 12.0, 250, 250, 250, 255);
            rl_draw_rectangle(x + 14.0, y + 17.0, 6.0, 6.0, 20, 20, 20, 255);
            flex (rizz i = 0; i < 5; i = i + 1) {
                rl_draw_rectangle(x + 10.0 + i * 20.0, y + h - 6.0, 10.0, 6.0,
                                  60, 50, 44, 255);
            }
        }
    }

    🚽 The opening is the only moment the bat matters, so it gets a ring.
    🚽 Without it the window is invisible and the fight is guesswork.
    edgy (phase == t_boss_open()) {
        rl_draw_rectangle(x - 4.0, y - 4.0, w + 8.0, 4.0, 255, 214, 64, 255);
        rl_draw_rectangle(x - 4.0, y + h, w + 8.0, 4.0, 255, 214, 64, 255);
        rl_draw_rectangle(x - 4.0, y, 4.0, h, 255, 214, 64, 255);
        rl_draw_rectangle(x + w, y, 4.0, h, 255, 214, 64, 255);
    }
}

skibidi draw_bomb(chad x, chad y, chad w, chad h, cap burning) {
    edgy (burning) {
        rl_draw_rectangle(x, y, w, h, 255, 148, 40, 255);
        rl_draw_rectangle(x + w * 0.15, y + h * 0.25, w * 0.7, h * 0.5,
                          255, 226, 120, 255);
    }
    amogus {
        rl_draw_rectangle(x, y, w, h, 34, 34, 40, 255);
        rl_draw_rectangle(x + w * 0.35, y - 6.0, w * 0.3, 6.0, 190, 140, 60, 255);
    }
}

🚽 Three pips, one per bonk still owed. Drawn top-centre so it does not
🚽 fight the hearts (top-left) or the score (top-right).
skibidi draw_boss_bar(rizz kind, rizz bonks) {
    chad bw = 64.0;
    chad x0 = t_screen_w() / 2.0 - (t_boss_bonks() * bw) / 2.0;
    rl_draw_rectangle(x0 - 8.0, 20.0, t_boss_bonks() * bw + 16.0, 26.0,
                      0, 0, 0, 140);
    flex (rizz i = 0; i < t_boss_bonks(); i = i + 1) {
        edgy (i < t_boss_bonks() - bonks) {
            rl_draw_rectangle(x0 + i * bw + 4.0, 24.0, bw - 8.0, 18.0,
                              214, 64, 64, 255);
        }
        amogus {
            rl_draw_rectangle(x0 + i * bw + 4.0, 24.0, bw - 8.0, 18.0,
                              60, 40, 40, 255);
        }
    }
    edgy (kind == t_boss_tralalero()) {
        rl_draw_text_int("TRALALERO TRALALA x", bonks, 0, x0 - 8.0, 50.0, 18,
                         255, 214, 64, 255);
    }
    amogus {
        rl_draw_text_int("BOMBARDIRO CROCODILO x", bonks, 0, x0 - 8.0, 50.0, 18,
                         255, 214, 64, 255);
    }
}
